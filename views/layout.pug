doctype html
html(lang="es")
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title KROMA - Iniciar Sesión
    link(rel='stylesheet', href='/css/styles.css')

  body
    header
      .logo
        a(href='/mapa')
          img(src='/imgs/logo_header.png', alt='KROMA')

      .nav-right
        a(href='/editor') EDITOR
        a(href='/desafios') DESAFIOS
        a(href='/paleta') PALETA
        a(href='#' style="cursor: default;") #{user.points} pts.

        .profile
          a(href="/perfil") 
            if user.profilepic === "usuario.png"
              img(src='/usuario.png' alt='Tu avatar')
            else 
              img(src=user.profilepic alt='Tu avatar')

    // Contenido que cambiará en cada página
    block content