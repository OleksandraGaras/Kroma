extends layout 

block content
  .container.profile-container
    .profile-content
      // Parte superior: Avatar + Nombre + Nivel + Puntos
      .profile-header
        .profile-left-column
          .profile-avatar-wrapper
            .profile-avatar.large
              if user.profilepic === "usuario.png"
                img(src='/usuario.png' alt='Tu avatar')
              else 
                img(src=user.profilepic alt='Tu avatar')
            .avatar-frame

          .upload-form-container
            form(action="/perfil/upload-avatar" method="POST" enctype="multipart/form-data" class="upload-form")
              label.file-input-label
                span.icon 📁
                span.text Seleccionar imagen...
                input(type="file" name="avatar" accept="image/*" required)
              button(type="submit" class="btn-upload") Actualizar Foto
        .profile-info
          h1.profile-name #{user.name}
          .profile-stats
            .stat-item
              span.stat-label Nivel
              span.stat-value.level-badge #{user.nivel}
            .stat-item
              span.stat-label Puntos
              span.stat-value #{user.points}
      // Lenguajes / Tecnologías (estilo barra de idiomas)
      .skills-section
        h2 Tecnolog&iacute;as dominadas
        .skills-list
          .skill-item
            span.skill-name HTML
            .skill-level-bar
              .skill-progress(style='width: 95%; background: #e34c26;')
            span.skill-level-text Avanzado
          .skill-item
            span.skill-name CSS
            .skill-level-bar
              .skill-progress(style='width: 88%; background: #1572b6;')
            span.skill-level-text Avanzado
          .skill-item
            span.skill-name JavaScript
            .skill-level-bar
              .skill-progress(style='width: 72%; background: #f0db4f;')
            span.skill-level-text Intermedio-Avanzado
          .skill-item
            span.skill-name PHP
            .skill-level-bar
              .skill-progress(style='width: 65%; background: #777bb4;')
            span.skill-level-text Intermedio
          .skill-item
            span.skill-name React
            .skill-level-bar
              .skill-progress(style='width: 45%; background: #61dafb;')
            span.skill-level-text Intermedio
      // Derecha: Colores de niveles + Insignias
      .achievements-section
        .level-colors
          h3 Paleta de niveles alcanzados
          .color-circles
            .color-circle.red
            .color-circle.orange
            .color-circle.yellow
            .color-circle.green
            .color-circle.blue
            .color-circle.purple
            .color-circle.cyan.active
        .badges-grid
          h3 Insignias obtenidas
          .badges-container
            .badge-item
              .badge.first-project
            .badge-item
              .badge.streak-30
            .badge-item
              .badge.css-master
            .badge-item
              .badge.js-ninja
            .badge-item.locked
              .badge
            .badge-item.locked
              .badge
