extends layout

block content
  main.learn-page(style="display: flex; justify-content: space-between; padding: 20px; height: calc(100vh - 80px); background: #0a0505; color: #eee; box-sizing: border-box;")
    // IZQUIERDA: EDITOR DE CÓDIGO
    section.editor-side(style="width: 48%; display: flex; flex-direction: column; height: 100%;")
      // Pestañas del Editor
      .editor-tabs(style="display: flex; gap: 10px; margin-bottom: 12px;")
        button#tab-html.tab.active HTML
        button#tab-css.tab CSS
        button#tab-js.tab JS
      
      // Editor Contenedor
      .code-editor(style="flex-grow: 1; height: calc(100% - 60px); position: relative; border: 1px solid #333; border-radius: 12px; overflow: hidden; background: #1e1e1e;")
        #editor-container(style="width: 100%; height: 100%;")
    
    // DERECHA: PREVIEW Y TERMINAL
    section.preview-side(style="width: 48%; display: flex; flex-direction: column; gap: 20px; height: 100%;")
      // Preview Ventana
      .preview-window(style="height: 60%; position: relative; border: 1px solid #333; border-radius: 12px; overflow: hidden; background: #fff;")
        // Botón Ejecutar Flotante
        button#run-btn(style="position: absolute; top: 10px; right: 10px; z-index: 100; padding: 10px 20px; background: #00ff00; color: #000; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; box-shadow: 0 4px 10px rgba(0,255,0,0.3); transition: all 0.2s;")
          | EXECUTAR COD &nbsp; &#9654;
        
        iframe#preview-iframe(sandbox="allow-scripts allow-modals" style="width: 100%; height: 100%; border: none; background: white;")
      
      // Terminal de la Consola
      .terminal-container(style="height: calc(40% - 20px); background: #1a1a1a; border-radius: 12px; border: 1px solid #333; padding: 15px; overflow-y: auto; font-family: monospace; font-size: 0.9rem;")
        #terminal-output(style="color: #00ff00;")
          div(style="color: #888; border-bottom: 1px solid #333; padding-bottom: 5px; margin-bottom: 10px;") Console Output:

  // Monaco Editor Loader & Client Script
  script(src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.44.0/min/vs/loader.min.js")
  script(src="/js/sandbox.js")
  
  // ALERTA PERSONALIZADA MODAL
  #custom-alert-modal.hidden(style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); z-index: 1000; display: flex; align-items: center; justify-content: center; backdrop-filter: blur(5px);")
    .modal-content(style="background: #2a2a2a; border: 2px solid #cc5555; border-radius: 16px; padding: 30px; max-width: 450px; width: 90%; text-align: center; box-shadow: 0 0 30px rgba(204, 85, 85, 0.4);")
      h2(style="color: #cc5555; font-size: 1.8rem; margin-top: 0; font-family: sans-serif;") Alerta
      p#custom-alert-message(style="color: #eee; font-size: 1.1rem; margin: 20px 0; line-height: 1.5; font-family: sans-serif;") Mensaje
      button(onclick="document.getElementById('custom-alert-modal').classList.add('hidden')" style="width: auto; padding: 10px 30px; background: #cc5555; color: #fff; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; font-family: sans-serif; font-size: 1rem; transition: background 0.2s;") D'ACORD

  style.
    .hidden { display: none !important; }
